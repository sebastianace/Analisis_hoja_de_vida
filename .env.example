# Copia este archivo a .env y completa los valores. El .env nunca se sube a Git.

# --- Opción A: OpenAI ---
OPENAI_API_KEY=sk-tu_clave_aqui
OPENAI_MODEL=gpt-4o-mini
# json_schema (por defecto) o function_calling
OPENAI_STRUCTURED_METHOD=json_schema

# --- Opción A2: Gemini (endpoint compatible con OpenAI, tiene capa gratuita) ---
# Clave en https://aistudio.google.com/apikey
# OPENAI_API_KEY=tu_clave_de_gemini
# OPENAI_MODEL=gemini-2.5-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_STRUCTURED_METHOD=json_schema

# --- Opción B: Ollama local, sin costo (llama3.1 8B no cumple las reglas de citas) ---
# Requiere 'ollama serve' activo y 'ollama pull llama3.1'.
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_STRUCTURED_METHOD=function_calling
